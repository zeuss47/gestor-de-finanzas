<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget Habituales: solo vistas de la lista oficial RemoteViews.
    Sin <View> spacer, sin emoji en XML, sin singleLine deprecated.
    Tema: verde esmeralda (#10B981) para identificar gastos recurrentes.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Titulo en la parte superior -->
    <LinearLayout
        android:id="@+id/wh_header_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestor de Finanzas"
            android:textColor="#4A5568"
            android:textSize="9sp"
            android:letterSpacing="0.1"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Habituales"
            android:textColor="#10B981"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="1dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#064E3B"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- Botones en la parte inferior -->
    <LinearLayout
        android:id="@+id/wh_btn_row"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">

        <TextView
            android:id="@+id/wh_btn_ver"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_btn_green_ghost"
            android:gravity="center"
            android:text="Ver habituales"
            android:textColor="#10B981"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/wh_btn_aprobar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_green"
            android:gravity="center"
            android:text="Aprobar mes"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Contenido central entre header y botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/wh_header_block"
        android:layout_above="@id/wh_btn_row"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/wh_item1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registros fijos del mes"
            android:textColor="#8892A4"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/wh_item2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tocar para ver y gestionar"
            android:textColor="#8892A4"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp"/>

        <TextView
            android:id="@+id/wh_item3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aprobar descuenta del saldo"
            android:textColor="#8892A4"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp"/>
    </LinearLayout>

</RelativeLayout>
