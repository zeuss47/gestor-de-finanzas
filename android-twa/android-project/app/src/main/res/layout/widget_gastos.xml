<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget Gastos: solo vistas de la lista oficial RemoteViews
    (LinearLayout, RelativeLayout, TextView, ImageView, ProgressBar, Button)
    Sin <View> como spacer (no garantizado), sin emoji en XML, sin singleLine.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Titulo y subtitulo en la parte superior -->
    <LinearLayout
        android:id="@+id/wg_header_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestor de Finanzas"
            android:textColor="#4A5568"
            android:textSize="9sp"
            android:letterSpacing="0.1"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gastos"
            android:textColor="#00F0FF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="1dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E2A3A"
            android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- Botones en la parte inferior -->
    <LinearLayout
        android:id="@+id/wg_btn_row"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true">

        <TextView
            android:id="@+id/wg_btn_historial"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_btn_ghost"
            android:gravity="center"
            android:text="Ver historial"
            android:textColor="#00F0FF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/wg_btn_nuevo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:text="+ Nuevo gasto"
            android:textColor="#050614"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Contenido central entre header y botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/wg_header_block"
        android:layout_above="@id/wg_btn_row"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/wg_item1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accede rapido a tus gastos"
            android:textColor="#8892A4"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/wg_item2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registra un nuevo gasto"
            android:textColor="#8892A4"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp"/>

        <TextView
            android:id="@+id/wg_item3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historial siempre disponible"
            android:textColor="#8892A4"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp"/>
    </LinearLayout>

</RelativeLayout>
