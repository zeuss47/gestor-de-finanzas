<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💸 Gastos"
            android:textColor="#00F0FF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/wg_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Finanzas"
            android:textColor="#4A5568"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2A3A"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Recent items (static placeholders — data via app) -->
    <TextView
        android:id="@+id/wg_item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Abrí la app para ver tus gastos"
        android:textColor="#8892A4"
        android:textSize="11sp"
        android:ellipsize="end"
        android:singleLine="true"/>

    <TextView
        android:id="@+id/wg_item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usá el botón ＋ para registrar"
        android:textColor="#8892A4"
        android:textSize="11sp"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginTop="3dp"/>

    <TextView
        android:id="@+id/wg_item3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Acceso rápido desde el widget"
        android:textColor="#8892A4"
        android:textSize="11sp"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginTop="3dp"/>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/wg_btn_historial"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_ghost"
            android:gravity="center"
            android:text="📋 Historial"
            android:textColor="#00F0FF"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/wg_btn_nuevo"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:text="＋ Gasto"
            android:textColor="#050614"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
