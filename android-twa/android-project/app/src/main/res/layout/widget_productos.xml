<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛒 Productos"
            android:textColor="#7C3AED"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Finanzas"
            android:textColor="#4A5568"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E2A3A"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Info text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escaneá o buscá productos"
        android:textColor="#8892A4"
        android:textSize="11sp"
        android:ellipsize="end"
        android:singleLine="true"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Compará precios entre supermercados"
        android:textColor="#8892A4"
        android:textSize="11sp"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginTop="3dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial de compras y listas"
        android:textColor="#8892A4"
        android:textSize="11sp"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginTop="3dp"/>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/wp_btn_lista"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_ghost"
            android:gravity="center"
            android:text="📦 Ver lista"
            android:textColor="#7C3AED"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/wp_btn_escanear"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_primary"
            android:gravity="center"
            android:text="📷 Escanear"
            android:textColor="#050614"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
